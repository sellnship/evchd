---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { sql, type Article } from '../../../lib/db';
import { getAvailableImageModels, getDefaultImageModel } from '../../../lib/llm';
import { getCategories } from '../../../lib/categories';
import { getAuthors } from '../../../lib/authors';

const { id } = Astro.params;
const isNew = id === 'new';

let article: Partial<Article> = {
  slug: Astro.url.searchParams.get('slug') ?? '',
  lang: (Astro.url.searchParams.get('lang') as 'en' | 'hi') ?? 'en',
  title: '',
  seo_title: '',
  description: '',
  category: '',
  hero_image: '',
  image_alt: '',
  image_caption: '',
  author: '',
  reviewed_by: '',
  tags: [],
  body_md: '',
  status: 'draft',
  source: 'manual',
};

if (!isNew) {
  const rows = (await sql()`SELECT * FROM articles WHERE id = ${Number(id)}`) as unknown as Article[];
  if (!rows.length) return Astro.redirect('/admin/blog');
  article = rows[0];
}

// EN↔HI pair: same slug, other lang.
let counterpart: Article | null = null;
if (!isNew && article.slug) {
  const other = article.lang === 'hi' ? 'en' : 'hi';
  const rows = (await sql()`SELECT * FROM articles WHERE slug = ${article.slug} AND lang = ${other}`) as unknown as Article[];
  counterpart = rows[0] ?? null;
}

const saved = Astro.url.searchParams.get('saved');
const err = Astro.url.searchParams.get('err');

// AI image generation rides on the OpenAI / Gemini keys. Model list = only
// models whose provider is configured; default = Settings choice or best.
const imageModels = await getAvailableImageModels();
const imagesReady = imageModels.length > 0;
const defaultImageModel = await getDefaultImageModel();

// Default image prompt "according to the article", editable before generating:
// prefer the queued topic's image scene, else derive one from title/category.
let defaultScene = '';
if (!isNew && article.slug) {
  const t = (await sql()`
    SELECT image_prompt FROM topics
    WHERE slug = ${article.slug} AND lang = ${article.lang}`) as { image_prompt: string }[];
  defaultScene = t[0]?.image_prompt?.trim() || '';
  if (!defaultScene) {
    defaultScene =
      `An everyday ${article.category || 'EV'} scene in Chandigarh/Mohali that illustrates ` +
      `"${article.title}" — real people, residential sectors, natural light.`;
  }
}

// Category dropdown from the DB; keep a legacy value selectable if the article
// has one that's no longer in the categories table.
const categories = await getCategories();
if (article.category && !categories.includes(article.category)) categories.unshift(article.category);

const authors = await getAuthors();
const defaultAuthorId = authors[0]?.id ?? '';
---
<AdminLayout title={isNew ? 'New Article' : `Edit: ${article.title}`} active="blog" sub={isNew ? 'Create a blog article' : `/${article.slug} (${article.lang})`}>
  {saved && <div class="alert alert-success py-2 small">Saved.</div>}
  {err && <div class="alert alert-danger py-2 small">Error: {decodeURIComponent(err)}</div>}

  <form method="post" action="/admin/api/blog/save" enctype="multipart/form-data">
    <input type="hidden" name="id" value={isNew ? '' : String(article.id)} />
    <div class="row g-3">
      <div class="col-lg-8">
        <div class="card p-3 mb-3">
          <div class="row g-3">
            <div class="col-md-8">
              <label class="form-label small">Title</label>
              <input class="form-control" name="title" value={article.title} required />
            </div>
            <div class="col-md-4">
              <label class="form-label small">Category</label>
              <select class="form-select" name="category">
                <option value="" disabled selected={!article.category}>— Select category —</option>
                {categories.map((c) => <option value={c} selected={c === article.category}>{c}</option>)}
              </select>
            </div>
            <div class="col-md-8">
              <label class="form-label small">Slug</label>
              <input class="form-control mono" name="slug" value={article.slug} pattern="[a-z0-9-]+" required readonly={!isNew} />
            </div>
            <div class="col-md-4">
              <label class="form-label small">Language</label>
              <select class="form-select" name="lang" disabled={!isNew}>
                <option value="en" selected={article.lang === 'en'}>English</option>
                <option value="hi" selected={article.lang === 'hi'}>Hindi</option>
              </select>
              {!isNew && <input type="hidden" name="lang" value={article.lang} />}
            </div>
            <div class="col-12">
              <label class="form-label small">SEO title (&lt;title&gt; tag — leave blank to reuse Title above)</label>
              <input class="form-control" name="seo_title" value={article.seo_title} maxlength="70" />
            </div>
            <div class="col-12">
              <label class="form-label small">Description (meta, ≤158 chars)</label>
              <textarea class="form-control" name="description" rows="2" maxlength="200">{article.description}</textarea>
            </div>
            <div class="col-md-6">
              <label class="form-label small">Author (byline)</label>
              <select class="form-select" name="author">
                {authors.map((a) => (
                  <option value={a.id} selected={a.id === (article.author || defaultAuthorId)}>{a.name}</option>
                ))}
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label small">Reviewed by</label>
              <select class="form-select" name="reviewed_by">
                {authors.map((a) => (
                  <option value={a.id} selected={a.id === (article.reviewed_by || defaultAuthorId)}>{a.name}</option>
                ))}
              </select>
            </div>
            <div class="col-12">
              <label class="form-label small">Tags (comma-separated)</label>
              <input class="form-control" name="tags" value={(article.tags ?? []).join(', ')} />
            </div>
          </div>
        </div>

        <div class="card p-3">
          <label class="form-label small fw-bold">Body (Markdown)</label>
          <textarea class="form-control body-editor" name="body_md" id="bodyEditor">{article.body_md}</textarea>
          {!isNew && imagesReady && (
            <div class="border-top border-secondary-subtle pt-2 mt-2">
              <label class="form-label small fw-bold mb-1">🖼 Insert AI image at cursor</label>
              <div class="d-flex gap-2">
                <input class="form-control form-control-sm" id="bodyImgPrompt"
                       placeholder="Describe the scene for this in-article image" />
                <select class="form-select form-select-sm w-auto" id="bodyImgModel">
                  {imageModels.map((m) => (
                    <option value={m.id} selected={m.id === defaultImageModel}>{m.label}</option>
                  ))}
                </select>
                <button class="btn btn-outline-light-subtle btn-sm flex-shrink-0" type="button" id="suggestBodyPromptBtn" title="Suggest a scene from this post">✨</button>
                <button class="btn btn-outline-light-subtle btn-sm flex-shrink-0" type="button" id="bodyImgBtn">Generate &amp; Insert</button>
              </div>
              <div class="small text-secondary mt-1" id="bodyImgStatus">Generates 16:9 (no watermark), uploads, and inserts the markdown where your cursor is. ✨ suggests a scene from the post.</div>
            </div>
          )}
        </div>
      </div>

      <div class="col-lg-4">
        <div class="card p-3 mb-3">
          <h2 class="h6 fw-bold">Status</h2>
          <p class="small mb-2">
            Current: <span class={`badge status-${article.status}`}>{article.status}</span>
            {article.source === 'ai' && <span class="badge lang-en ms-1">AI draft</span>}
          </p>
          <button class="btn btn-accent w-100 mb-2" type="submit" name="action" value="save">💾 Save</button>
          {!isNew && article.status === 'draft' && (
            <button class="btn btn-success w-100 mb-2" type="submit" name="action" value="publish"
              onclick="return confirm('Publish this article and rebuild the website?')">🚀 Save &amp; Publish</button>
          )}
          {!isNew && article.status === 'published' && (
            <button class="btn btn-outline-light-subtle w-100 mb-2" type="submit" name="action" value="unpublish"
              onclick="return confirm('Unpublish? The article will disappear from the site on next rebuild.')">Unpublish</button>
          )}
          <div class="small text-secondary">Publishing flips the status and fires the Vercel deploy hook — live in ~1–2 min.</div>
        </div>

        <div class="card p-3 mb-3">
          <h2 class="h6 fw-bold">Hero image</h2>
          {article.hero_image ? (
            <img class="hero-thumb mb-2" src={article.hero_image} alt="hero" />
          ) : (
            <p class="small text-secondary">No hero yet.</p>
          )}
          <label class="form-label small mb-1">Upload your own</label>
          <input class="form-control form-control-sm" type="file" name="hero" accept="image/*" />
          <div class="small text-secondary mt-1 mb-2">Resized to 1200×675 WebP on Vercel Blob (saved with 💾 Save).</div>

          <label class="form-label small mb-1">Alt text (accessibility &amp; SEO)</label>
          <input class="form-control form-control-sm mb-2" name="image_alt" value={article.image_alt} />
          <label class="form-label small mb-1">Caption (optional, shown under image)</label>
          <input class="form-control form-control-sm mb-2" name="image_caption" value={article.image_caption} />

          <div class="border-top border-secondary-subtle pt-2">
            <label class="form-label small fw-bold mb-1">🎨 Generate with AI</label>
            {isNew ? (
              <div class="small text-secondary">💾 Save the article once, then generate a hero here.</div>
            ) : !imagesReady ? (
              <div class="alert alert-warning py-2 small mb-0">
                Image generation needs an <b>OpenAI</b> or <b>Gemini</b> key —
                <a href="/admin/settings">add one in Settings</a>.
              </div>
            ) : (
              <>
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <span></span>
                  <button class="btn btn-link btn-sm p-0" type="button" id="suggestHeroPromptBtn">✨ Suggest from post</button>
                </div>
                <textarea class="form-control form-control-sm mb-2" name="image_prompt" form="genheroForm" rows="3" required
                  id="heroScenePrompt"
                  placeholder="Describe the SCENE (vehicle & style rules are added automatically)">{defaultScene}</textarea>
                <div class="small text-secondary mt-1 mb-2" id="suggestHeroPromptStatus"></div>
                <label class="form-label small mb-1">Image model</label>
                <select class="form-select form-select-sm mb-2" name="image_model" form="genheroForm">
                  {imageModels.map((m) => (
                    <option value={m.id} selected={m.id === defaultImageModel}>{m.label}</option>
                  ))}
                </select>
                <button class="btn btn-accent btn-sm w-100" type="submit" form="genheroForm"
                  onclick="this.textContent='Generating… (~20s)'; ">🎨 Generate Hero</button>
                <div class="small text-secondary mt-1">Generates 16:9, brands it (1200×675 + logo), saves to this article.</div>
              </>
            )}
          </div>
        </div>

        {!isNew && (
          <div class="card p-3">
            <h2 class="h6 fw-bold">Translation pair</h2>
            {counterpart ? (
              <>
                <a class="btn btn-outline-light-subtle btn-sm w-100 mb-2" href={`/admin/blog/${counterpart.id}`}>
                  Edit {article.lang === 'hi' ? 'English' : 'Hindi'} version
                </a>
                {article.lang === 'hi' && (
                  <div class="border-top border-secondary-subtle pt-2">
                    <button class="btn btn-outline-warning btn-sm w-100" type="button" id="syncFromEnBtn">
                      🔄 Regenerate from English
                    </button>
                    <div class="small text-secondary mt-1" id="syncFromEnStatus">
                      Translates &amp; syncs title, description, and body from the English counterpart using AI.
                    </div>
                  </div>
                )}
              </>
            ) : article.lang === 'en' ? (
              <>
                <button class="btn btn-accent btn-sm w-100 mb-2" type="button" id="translateToHiBtn">
                  🤖 Translate to Hindi with AI
                </button>
                <div class="small text-secondary mb-2" id="translateToHiStatus">
                  Creates the Hindi version as a draft from this English article — review &amp; edit before publishing.
                </div>
                <a class="btn btn-outline-light-subtle btn-sm w-100"
                   href={`/admin/blog/new?slug=${article.slug}&lang=hi`}>
                  ＋ Or write the Hindi version manually
                </a>
              </>
            ) : (
              <a class="btn btn-outline-light-subtle btn-sm w-100"
                 href={`/admin/blog/new?slug=${article.slug}&lang=en`}>
                ＋ Create English counterpart
              </a>
            )}
            <div class="small text-secondary mt-2">EN &amp; HI share the slug — that's the language-toggle link on the site.</div>
          </div>
        )}
      </div>
    </div>
  </form>

  {!isNew && (
    // Separate form for AI hero generation — referenced via form="genheroForm"
    // by the controls inside the hero card (HTML forms cannot nest).
    <form id="genheroForm" method="post" action="/admin/api/blog/genhero">
      <input type="hidden" name="id" value={String(article.id)} />
    </form>
  )}

  {!isNew && (
    <script define:vars={{ articleId: article.id, isHi: article.lang === 'hi', hasCounterpart: Boolean(counterpart) }}>
      // 1. In-body image generation
      const bodyBtn = document.getElementById('bodyImgBtn');
      const bodyStatusEl = document.getElementById('bodyImgStatus');
      bodyBtn?.addEventListener('click', async () => {
        const editor = document.getElementById('bodyEditor');
        const prompt = document.getElementById('bodyImgPrompt')?.value?.trim();
        const model = document.getElementById('bodyImgModel')?.value;
        if (!prompt) { if (bodyStatusEl) bodyStatusEl.textContent = 'Describe the scene first.'; return; }
        bodyBtn.disabled = true;
        if (bodyStatusEl) bodyStatusEl.textContent = 'Generating… (~20s)';
        try {
          const res = await fetch('/admin/api/blog/genimage', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ id: articleId, prompt, image_model: model }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'generation failed');
          const md = `\n\n![${prompt.replace(/[\[\]]/g, '')}](${data.url})\n\n`;
          const pos = editor.selectionStart ?? editor.value.length;
          editor.value = editor.value.slice(0, pos) + md + editor.value.slice(pos);
          if (bodyStatusEl) bodyStatusEl.textContent = '✓ Inserted — remember to 💾 Save.';
          const inputEl = document.getElementById('bodyImgPrompt');
          if (inputEl) inputEl.value = '';
        } catch (e) {
          if (bodyStatusEl) bodyStatusEl.textContent = '✗ ' + e.message;
        } finally {
          bodyBtn.disabled = false;
        }
      });

      // 2. Regenerate / Sync Hindi from English counterpart
      const syncBtn = document.getElementById('syncFromEnBtn');
      const syncStatus = document.getElementById('syncFromEnStatus');
      syncBtn?.addEventListener('click', async () => {
        if (!confirm('Regenerate this Hindi article from the English version? This will update the title, description, and body to match English.')) return;
        syncBtn.disabled = true;
        syncStatus.textContent = 'Translating from English with AI… (~20–30s)';
        try {
          const res = await fetch('/admin/api/blog/sync-from-en', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ id: articleId }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Failed to regenerate from English');
          
          const titleInput = document.querySelector('input[name="title"]');
          if (titleInput && data.title) titleInput.value = data.title;

          const descInput = document.querySelector('textarea[name="description"]');
          if (descInput && data.description) descInput.value = data.description;

          const bodyInput = document.getElementById('bodyEditor');
          if (bodyInput && data.body_md) bodyInput.value = data.body_md;

          syncStatus.textContent = '✓ Successfully regenerated from English! Reloading…';
          setTimeout(() => {
            window.location.search = '?saved=1';
          }, 800);
        } catch (err) {
          syncStatus.textContent = '✗ ' + err.message;
        } finally {
          syncBtn.disabled = false;
        }
      });

      // 3. Suggest an image scene from the current post content
      function currentPostFields() {
        return {
          title: document.querySelector('input[name="title"]')?.value ?? '',
          description: document.querySelector('textarea[name="description"]')?.value ?? '',
          category: document.querySelector('select[name="category"]')?.value ?? '',
          body_md: document.getElementById('bodyEditor')?.value ?? '',
        };
      }
      async function suggestScene(statusEl) {
        if (statusEl) statusEl.textContent = 'Reading the post… (~10s)';
        const res = await fetch('/admin/api/blog/suggest-image-prompt', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(currentPostFields()),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) throw new Error(data.error || 'suggestion failed');
        return data.scene;
      }

      const suggestHeroBtn = document.getElementById('suggestHeroPromptBtn');
      const suggestHeroStatus = document.getElementById('suggestHeroPromptStatus');
      suggestHeroBtn?.addEventListener('click', async () => {
        suggestHeroBtn.disabled = true;
        try {
          const scene = await suggestScene(suggestHeroStatus);
          document.getElementById('heroScenePrompt').value = scene;
          if (suggestHeroStatus) suggestHeroStatus.textContent = '✓ Suggested — edit freely before generating.';
        } catch (e) {
          if (suggestHeroStatus) suggestHeroStatus.textContent = '✗ ' + e.message;
        } finally {
          suggestHeroBtn.disabled = false;
        }
      });

      const suggestBodyBtn = document.getElementById('suggestBodyPromptBtn');
      suggestBodyBtn?.addEventListener('click', async () => {
        suggestBodyBtn.disabled = true;
        if (bodyStatusEl) bodyStatusEl.textContent = 'Reading the post… (~10s)';
        try {
          const scene = await suggestScene(bodyStatusEl);
          document.getElementById('bodyImgPrompt').value = scene;
          if (bodyStatusEl) bodyStatusEl.textContent = '✓ Suggested — edit freely before generating.';
        } catch (e) {
          if (bodyStatusEl) bodyStatusEl.textContent = '✗ ' + e.message;
        } finally {
          suggestBodyBtn.disabled = false;
        }
      });

      // 4. Translate this English article to Hindi (creates a new draft article)
      const translateBtn = document.getElementById('translateToHiBtn');
      const translateStatus = document.getElementById('translateToHiStatus');
      translateBtn?.addEventListener('click', async () => {
        if (!confirm('Create the Hindi version of this article via AI translation? You can edit it afterward.')) return;
        translateBtn.disabled = true;
        translateStatus.textContent = 'Translating to Hindi with AI… (~20–30s)';
        try {
          const res = await fetch('/admin/api/blog/translate-to-hi', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ id: articleId }),
          });
          const data = await res.json();
          if (!res.ok || !data.ok) throw new Error(data.error || 'Translation failed');
          translateStatus.textContent = '✓ Hindi draft created — opening it…';
          window.location.href = `/admin/blog/${data.id}?saved=1`;
        } catch (err) {
          translateStatus.textContent = '✗ ' + err.message;
          translateBtn.disabled = false;
        }
      });
    </script>
  )}
</AdminLayout>
