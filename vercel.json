{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "astro build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/admin", "destination": "https://evchd-admin.vercel.app/admin" },
    { "source": "/admin/", "destination": "https://evchd-admin.vercel.app/admin/" },
    { "source": "/admin/:path*", "destination": "https://evchd-admin.vercel.app/admin/:path*" },
    { "source": "/_admin-astro/:path*", "destination": "https://evchd-admin.vercel.app/_admin-astro/:path*" }
  ]
}
