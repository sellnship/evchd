---
/**
 * BaseLayout — every page inherits this.
 *
 * Carries the Google-Discover + SEO head, the site chrome (Header / Footer),
 * and the design-system tokens. Fonts load via Google Fonts with display=swap
 * (per the redesign reference).
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, toEnPath, toHiPath } from '../i18n';

interface Props {
  title: string;
  description: string;
  heroImage?: string;
  author?: string;
  datePublished?: string;
  dateModified?: string;
  type?: string;
}

const {
  title,
  description,
  heroImage,
  author,
  datePublished,
  dateModified,
  type = 'article',
} = Astro.props;

const site = 'https://evchandigarh.in';
// Build the canonical from the page path + production origin, so it is always
// the live URL even when building locally or on a preview deployment.
const canonical = new URL(Astro.url.pathname, site).href;
// OG/Twitter/JSON-LD images must be absolute URLs.
const ogImage = heroImage ? new URL(heroImage, site).href : undefined;

// Language is derived from the route: anything under /hi is Hindi.
const lang = getLangFromUrl(Astro.url);
const htmlLang = lang === 'hi' ? 'hi-IN' : 'en-IN';
const inLanguage = lang === 'hi' ? 'hi-IN' : 'en-IN';
// hreflang alternates point at the EN↔HI counterparts of this exact page.
const enHref = new URL(toEnPath(Astro.url.pathname), site).href;
const hiHref = new URL(toHiPath(Astro.url.pathname), site).href;
const rssHref = `${site}${lang === 'hi' ? '/hi/rss.xml' : '/rss.xml'}`;

// Article structured data — only emitted for article pages that carry a date,
// so we never ship an invalid Article block (e.g. on the home page).
const articleSchema =
  type === 'article' && datePublished
    ? {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: title,
        description: description,
        image: ogImage,
        inLanguage: inLanguage,
        datePublished: datePublished,
        dateModified: dateModified ?? datePublished,
        author: { '@type': 'Person', name: author },
        publisher: {
          '@type': 'Organization',
          name: 'EV Chandigarh',
          url: site,
        },
      }
    : null;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <!-- Discover-critical: zoomable viewport (never user-scalable=0) -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Bilingual: hreflang alternates pointing at the EN↔HI counterparts -->
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="hi" href={hiHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />

    <!-- Favicons (generated from src/assets/logomark.svg via npm run gen:icons) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Discover-critical: enables the large-image card in Discover (+CTR) -->
    <meta name="robots" content="max-image-preview:large, index, follow" />

    <!-- Fonts: Google Fonts, display=swap (non-render-blocking) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    {/* Devanagari coverage — loaded only on Hindi pages so English stays light */}
    {lang === 'hi' && (
      <link
        href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap"
        rel="stylesheet"
      />
    )}

    <!-- Open Graph (hero images are 1200x675 / 16:9) -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="EV Chandigarh" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- RSS alternate → enables the Discover "Follow" button (feed added later) -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="EV Chandigarh"
      href={rssHref}
    />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#E9E6DF" />

    {
      articleSchema && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(articleSchema)}
        />
      )
    }

    <!-- Flash-free reveals: hide animated elements before paint ONLY when motion
         is allowed; a 2s failsafe reveals them even if JS/GSAP never runs. -->
    <script is:inline>
      (function () {
        try {
          if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
            var de = document.documentElement;
            de.classList.add('pre-anim');
            setTimeout(function () { de.classList.remove('pre-anim'); }, 2000);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
