---
/**
 * BaseLayout — every page inherits this.
 *
 * Carries the Google-Discover + SEO head, the site chrome (Header / Footer),
 * and the design-system tokens. Fonts load via Google Fonts with display=swap
 * (per the redesign reference).
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations, localizePath, toEnPath } from '../i18n';
import { resolveCounterpart } from '../lib/counterpart';
import { authors } from '../data/types';

interface Props {
  title: string;
  description: string;
  heroImage?: string;
  author?: string;
  datePublished?: string;
  dateModified?: string;
  type?: string;
}

const {
  title,
  description,
  heroImage,
  author,
  datePublished,
  dateModified,
  type = 'article',
} = Astro.props;

const site = 'https://www.evchandigarh.in';
// Build the canonical from the page path + production origin, so it is always
// the live URL even when building locally or on a preview deployment.
const canonical = new URL(Astro.url.pathname, site).href;
// OG/Twitter/JSON-LD images must be absolute URLs. Pages without a hero fall
// back to the branded site default so social cards are never blank.
const DEFAULT_OG = '/images/og-default.webp';
const ogImage = new URL(heroImage ?? DEFAULT_OG, site).href;
// Organization logo (ImageObject) — used by Article publisher + the homepage graph.
const logo = { '@type': 'ImageObject', url: new URL('/images/logo.png', site).href, width: 940, height: 200 };

// Language is derived from the route: anything under /hi is Hindi.
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const htmlLang = lang === 'hi' ? 'hi-IN' : 'en-IN';
const inLanguage = lang === 'hi' ? 'hi-IN' : 'en-IN';
// hreflang alternates point at the EN↔HI counterparts of this exact page — but
// ONLY when the counterpart actually exists, so we never advertise a 404 to
// Google. The toggle in the header uses the same resolver, so the two agree.
const counterpart = await resolveCounterpart(Astro.url.pathname, lang);
const counterHref = new URL(counterpart.href, site).href;
const enAltHref = lang === 'en' ? canonical : counterpart.exists ? counterHref : null;
const hiAltHref = lang === 'hi' ? canonical : counterpart.exists ? counterHref : null;
const xDefaultHref = enAltHref ?? canonical;
const rssHref = `${site}${lang === 'hi' ? '/hi/rss.xml' : '/rss.xml'}`;

// Article structured data — only emitted for article pages that carry a date,
// so we never ship an invalid Article block (e.g. on the home page).
const articleSchema =
  type === 'article' && datePublished
    ? {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: title,
        description: description,
        image: ogImage,
        inLanguage: inLanguage,
        datePublished: datePublished,
        dateModified: dateModified ?? datePublished,
        author: { '@type': 'Person', name: author },
        publisher: {
          '@type': 'Organization',
          name: 'EV Chandigarh',
          url: site,
          logo,
        },
      }
    : null;

// Homepage gets the site-level WebSite + Organization graph (the canonical entry
// point for search engines). Only emit real publisher fields (not placeholders).
const pub = authors.publisher;
const isPlaceholder = (s?: string) => !s || /REPLACE/i.test(s);
const enPath = toEnPath(Astro.url.pathname);
const isHome = enPath === '/';
const org: Record<string, unknown> = { '@type': 'Organization', name: pub.name, url: site, logo };
if (!isPlaceholder(pub.legal_entity)) org.legalName = pub.legal_entity;
if (!isPlaceholder(pub.address)) org.address = pub.address;
if (!isPlaceholder(pub.phone)) org.telephone = pub.phone;
const siteGraph = isHome
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        org,
        { '@type': 'WebSite', name: 'EV Chandigarh', url: site, inLanguage },
      ],
    }
  : null;

// BreadcrumbList for every non-home page — Home › Section › (article title).
const segs = enPath.split('/').filter(Boolean);
const SECTION_KEYS: Record<string, string> = {
  guides: 'nav.guides', compare: 'nav.compare', news: 'nav.news', glossary: 'nav.glossary',
  calculators: 'nav.calculators', about: 'nav.about', contact: 'nav.contact', 'editorial-policy': 'nav.editorial',
};
const titleCase = (s: string) => s.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
const crumbItems = segs.map((seg, i) => {
  const isLeafDetail = i === segs.length - 1 && segs.length === 2;
  const name = isLeafDetail ? title : SECTION_KEYS[seg] ? t(SECTION_KEYS[seg] as any) : titleCase(seg);
  const path = localizePath('/' + segs.slice(0, i + 1).join('/'), lang);
  return { '@type': 'ListItem', position: i + 2, name, item: new URL(path, site).href };
});
const breadcrumb = segs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t('nav.home' as any) ?? 'Home', item: new URL(localizePath('/', lang), site).href },
        ...crumbItems,
      ],
    }
  : null;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <!-- Discover-critical: zoomable viewport (never user-scalable=0) -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Bilingual: hreflang alternates — counterpart emitted only when it exists -->
    {enAltHref && <link rel="alternate" hreflang="en" href={enAltHref} />}
    {hiAltHref && <link rel="alternate" hreflang="hi" href={hiAltHref} />}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    <!-- Favicons (generated from src/assets/logomark.svg via npm run gen:icons) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Discover-critical: enables the large-image card in Discover (+CTR) -->
    <meta name="robots" content="max-image-preview:large, index, follow" />

    <!-- Fonts: Google Fonts, display=swap (non-render-blocking) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    {/* Devanagari coverage — loaded only on Hindi pages so English stays light */}
    {lang === 'hi' && (
      <link
        href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap"
        rel="stylesheet"
      />
    )}

    <!-- Open Graph (hero images are 1200x675 / 16:9) -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="EV Chandigarh" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- RSS alternate → enables the Discover "Follow" button (feed added later) -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="EV Chandigarh"
      href={rssHref}
    />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#E9E6DF" />

    {
      articleSchema && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(articleSchema)}
        />
      )
    }
    {siteGraph && <script type="application/ld+json" set:html={JSON.stringify(siteGraph)} />}
    {breadcrumb && <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />}

    <!-- Flash-free reveals: hide animated elements before paint ONLY when motion
         is allowed; a 2s failsafe reveals them even if JS/GSAP never runs. -->
    <script is:inline>
      (function () {
        try {
          if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
            var de = document.documentElement;
            de.classList.add('pre-anim');
            setTimeout(function () { de.classList.remove('pre-anim'); }, 2000);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t('a11y.skip')}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
