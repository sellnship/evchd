---
import '../../styles/inner.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
---
<BaseLayout
  title="संपादकीय नीति — EV Chandigarh"
  description="हम क्या और कैसे प्रकाशित करते हैं, कौन जाँचता है, ग़लती कैसे बताएँ, और हम गाड़ियाँ बेचने वालों से स्वतंत्र क्यों रहते हैं।"
  type="website"
>
  <section class="page">
    <header class="page-head">
      <Eyebrow text="संपादकीय नीति" />
      <h1 class="page-title disp">हम कैसे काम करते हैं, और हमें कैसे जवाबदेह ठहराएँ</h1>
      <p class="page-lede">सटीकता और स्वतंत्रता — इस प्रकाशन के पास बस यही दो चीज़ें हैं। यह पन्ना साफ़-साफ़ बताता है कि हम दोनों कैसे कमाने की कोशिश करते हैं — और ग़लती होने पर हमें कैसे बताएँ।</p>
    </header>

    <div class="page-body prose">
      <h2>हम कैसे रिसर्च और सोर्स करते हैं</h2>
      <p>हर तथ्य — कोई टैरिफ़, रजिस्ट्रेशन नियम, सब्सिडी की तारीख़, या स्पेक — किसी प्राथमिक या उसके क़रीबी स्रोत से जाँचा जाता है: संबंधित नियम (जैसे Central Motor Vehicles Rules), बिजली रेगुलेटर का टैरिफ़ ऑर्डर, निर्माता की अपनी लिस्टिंग, या भरोसेमंद रिपोर्टिंग। जहाँ कोई आँकड़ा रेंज है या वैरिएंट/राज्य/समय से बदलता है, हम वो साफ़ बताते हैं।</p>
      <p>हम अपने तथ्यों पर तारीख़ डालते हैं। समय के साथ बदलने वाली चीज़ें — बिजली टैरिफ़, सब्सिडी, कीमतें — के साथ वो अवधि लिखी होती है जब उन्हें जाँचा गया, और हम इन्हें समय-समय पर दोबारा जाँचते हैं। अगर हम किसी बात को अपनी तसल्ली तक पक्का न कर पाएँ, तो उसे तथ्य के रूप में नहीं छापते।</p>

      <hr />

      <h2>कौन जाँचता है</h2>
      <p>लेख पहले लिखे जाते हैं, फिर प्रकाशन से पहले एक नामित व्यक्ति उन्हें जाँचता है। हर पन्ने पर दिखता है कि किसने लिखा और किसने जाँचा, साथ में प्रकाशन और आख़िरी अपडेट की तारीख़।</p>

      <hr />

      <h2>सुधार — ग़लती कैसे बताएँ</h2>
      <p>हमसे ग़लतियाँ होंगी, और जब होंगी तो हम उन्हें रिकॉर्ड पर ठीक करेंगे। अगर आपको कोई ग़लती दिखे — पुराना नंबर, ग़लत समझा गया नियम, या कोई दावा जो टिकता न हो — हमें बताएँ, हम उसे स्रोत से मिलाकर जल्दी ठीक करेंगे। बड़े सुधार लेख की "Updated" तारीख़ में दिखते हैं।</p>
      <p>ग़लती बताने के लिए हमें WhatsApp पर या हमारे संपर्क पते पर लिखें (देखें <a href="/hi/about">हमारे बारे में</a>)। कृपया पन्ना और वो ख़ास दावा बताएँ ताकि हम जल्दी जाँच सकें।</p>

      <hr />

      <h2>हमारी स्वतंत्रता</h2>
      <p><strong>हम गाड़ियाँ नहीं बेचते।</strong> EV Chandigarh जानकारी छापता है, स्टॉक नहीं — कोई कीमत नहीं, कोई बुकिंग नहीं, कोई डीलर पेज नहीं। जब आप ख़रीदने के लिए तैयार हों, हम बताते हैं कहाँ से ख़रीदें: हमारा कॉमर्स पार्टनर <a href="https://evchandigarh.com" rel="noopener">evchandigarh.com</a> और एक WhatsApp लाइन। ख़रीद और समझाने को अलग रखना ही हमारी राय को निष्पक्ष रखता है।</p>
      <p>हम एक कैटेगरी के बारे में लिखते हैं, किसी कैटलॉग के बारे में नहीं। जब कोई ख़ास मॉडल किसी बात को समझाने का सबसे साफ़ तरीक़ा हो, हम उसे उसकी श्रेणी के उदाहरण के तौर पर नाम लेते हैं — कभी "हमारे" प्रोडक्ट के तौर पर नहीं।</p>
    </div>
  </section>
</BaseLayout>
