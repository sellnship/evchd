---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Divider from '../components/Divider.astro';
import Button from '../components/Button.astro';
import HubCard from '../components/HubCard.astro';
import FeaturedCard from '../components/FeaturedCard.astro';
import { localFacts } from '../data/types';
import { whatsappHref, useTranslations } from '../i18n';

// Canonical, language-correct WhatsApp deep link (English homepage).
const waHref = whatsappHref('en');
const t = useTranslations('en');

// Math stats: read from the data layer where they map.
const perKm = localFacts.charging_cost.per_km_inr; // 0.17
const fullCharge =
  Number(String(localFacts.charging_cost.full_charge_cost_inr).split('-').pop()) || 10; // "10" → 10

const featured = [
  {
    href: '/guides/escooter-licence',
    img: '/images/home-charging.webp',
    alt: 'An electric scooter charging from a regular wall socket at an Indian home.',
    cat: 'Guide · Rules',
    title: 'Do you actually need a licence for an e-scooter in Chandigarh?',
    desc: 'The ≤25 km/h, ≤250W rule — and the catch most sellers won’t mention.',
  },
  {
    href: '/guides/petrol-vs-ev-scooter-cost',
    img: '/images/sector-road.webp',
    alt: 'An electric scooter on a clean, tree-lined Chandigarh sector road.',
    cat: 'Comparison · Cost',
    title: 'Petrol vs EV: the real monthly cost across the Tricity',
    desc: 'At ₹0.17/km on Chandigarh power, here’s where the break-even lands.',
  },
  {
    href: '/guides/home-charging-cost',
    img: '/images/charging-plug.webp',
    alt: 'An electric scooter charging from a normal 3-pin domestic wall socket at a Tricity home.',
    cat: 'Guide · Charging',
    title: 'Charging at home in Mohali: what it really costs per month',
    desc: 'Two units a night, on a normal socket — the numbers, slab by slab.',
  },
];

const hubs = [
  { num: '01 / How-to & rules', title: 'Guides', href: '/guides', desc: 'The rules that actually apply — RTO, registration, home charging and subsidies across Punjab, Haryana and Chandigarh.' },
  { num: '02 / Side by side', title: 'Comparisons', href: '/compare', desc: 'The numbers that matter: range, real running cost, charging time and price bands — across brands, not just one.' },
  { num: '03 / Your numbers', title: 'Calculators', href: '/calculators', desc: 'Work it out for yourself — monthly running cost, petrol-versus-EV break-even and charging cost on local tariffs.' },
];
---

<BaseLayout
  title="EV Chandigarh — The Tricity's independent guide to going electric"
  description="Independent, local electric-mobility guidance for Chandigarh, Mohali and Panchkula. Real numbers, honest comparisons, no sales pitch."
  type="website"
>
  <!-- HERO: three.js grid on desktop; CSS-only concrete grid on mobile/no-WebGL -->
  <section class="hero">
    <canvas id="grid"></canvas>
    <div class="wrap hero-inner">
      <span class="hint hint--desktop">Move your cursor — <b>energise the grid</b></span>
      <span class="hint hint--mobile">The Tricity EV grid</span>
      <h1 class="reveal">The Tricity's <span class="em">independent</span> guide to going electric.</h1>
      <p class="lede reveal">Real local numbers, honest comparisons, and clear guides for life with an EV across Chandigarh, Mohali and Panchkula. We answer the questions — we don't sell the vehicles.</p>
      <div class="cta-row reveal">
        <Button variant="solid" href="/guides" arrow>Browse the guides</Button>
        <Button variant="ghost" href="/editorial-policy">How we work →</Button>
      </div>
    </div>
    <div class="hero-scroll"><span class="ln"></span>Scroll</div>
  </section>

  <!-- STANCE -->
  <section class="stance">
    <div class="wrap">
      <Eyebrow text="Why we exist" />
      <p class="big reveal" style="margin-top:22px;">Most EV pages are <b>showrooms in disguise.</b> This one isn't. We're a Tricity-first publication that explains the rules, the running costs and the real-world range — then points you to where to buy.</p>
      <p class="sub reveal">Search results push you toward whatever pays the most. We start from your commute, your budget and the law as it actually applies in Chandigarh, Mohali and Panchkula.</p>
    </div>
  </section>

  <!-- FEATURED CARDS -->
  <section class="featured">
    <div class="wrap">
      <div class="feat-head">
        <div><Eyebrow text="Latest" /><h2 class="disp" style="margin-top:14px;">Read these first</h2></div>
        <Button variant="ghost" href="/guides">All guides →</Button>
      </div>
      <div class="feat-grid">
        {featured.map((c) => <FeaturedCard {...c} />)}
      </div>
    </div>
  </section>

  <!-- HUBS -->
  <section class="hubs">
    <div class="wrap">
      <div class="hubs-head">
        <div><Eyebrow text="The hubs" /><h2 class="disp" style="margin-top:16px;">Start where<br />your question is.</h2></div>
        <Divider style="flex:1;min-width:140px;max-width:300px;margin-bottom:10px;" />
      </div>
      <div class="hub-grid">
        {hubs.map((h) => <HubCard {...h} />)}
      </div>
    </div>
  </section>

  <!-- THE MATH (dark, count-up) -->
  <section class="math">
    <canvas id="nightgrid"></canvas>
    <div class="wrap">
      <Eyebrow text="The math" spark={false} />
      <h2>A low-speed EV runs on <span class="em">Chandigarh's cheap power</span> — and skips the paperwork entirely.</h2>
      <div class="stat-row">
        <div class="stat">
          <div class="fig" data-count={perKm} data-prefix="₹" data-dec="2">₹{perKm.toFixed(2)}<span class="unit">/km</span></div>
          <div class="cap">Running cost on Chandigarh domestic power — versus ₹2.5–3.3/km on petrol.</div>
          <div class="barwrap"><div class="bar" data-bar="92"></div></div>
        </div>
        <div class="stat">
          <div class="fig" data-count="0" data-prefix="₹" data-dec="0">₹0<span class="unit">RTO</span></div>
          <div class="cap">No registration, no road tax, no licence on a true ≤25 km/h, ≤250W scooter.</div>
          <div class="barwrap"><div class="bar" data-bar="100"></div></div>
        </div>
        <div class="stat">
          <div class="fig" data-count={fullCharge} data-prefix="₹" data-dec="0">₹{fullCharge}<span class="unit">/charge</span></div>
          <div class="cap">A full overnight charge — roughly 2 units — against ₹150–200 of petrol.</div>
          <div class="barwrap"><div class="bar" data-bar="88"></div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="wrap">
      <div class="cta-card">
        <div class="glow"></div>
        <h2 class="reveal">Done reading? Ready to buy?</h2>
        <p class="reveal">We don't sell here — but we know who does. Get current prices, book a test ride, or ask us anything on WhatsApp.</p>
        <div class="row reveal">
          <Button variant="light" href="https://evchandigarh.com" arrow>See prices &amp; book on evchandigarh.com</Button>
          <Button variant="wa" href={waHref} target="_blank" rel="noopener" aria-label={t('cta.whatsappAria')} arrow>Ask on WhatsApp</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ============ HERO: lazy-loaded three.js grid ============
     three.js is dynamically imported (own chunk) only when the hero is in
     view, and the render loop runs only while visible — never blocks first
     paint, never burns CPU below the fold. */
  (function lazyHero() {
    const canvas = document.getElementById('grid');
    if (!canvas) return;
    // Disable the 3D hero on mobile, low-memory devices, and reduced-motion —
    // three.js is too heavy for low-end Android. The hero then stays static.
    const nav = navigator as Navigator & { deviceMemory?: number };
    const allow3D =
      !reduced &&
      !window.matchMedia('(max-width: 768px)').matches &&
      !(typeof nav.deviceMemory === 'number' && nav.deviceMemory < 4);
    if (!allow3D) return;
    let api: { start: () => void; stop: () => void } | null = null;
    let visible = false;
    let loading = false;

    async function ensure() {
      if (api || loading) return;
      loading = true;
      try {
        const THREE = await import('three');
        api = createGridHero(THREE, canvas as HTMLCanvasElement, reduced);
        // Mark the hero as 3D so CSS hides the static grid + shows the cursor hint.
        (canvas.closest('.hero') as HTMLElement | null)?.setAttribute('data-grid', '3d');
        if (visible) api.start();
      } catch (e) {
        /* no WebGL / failed import → hero simply has no grid */
      } finally {
        loading = false;
      }
    }

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          visible = e.isIntersecting;
          if (visible) ensure().then(() => api && api.start());
          else if (api) api.stop();
        }
      },
      { threshold: 0.01 },
    );
    io.observe(canvas);
  })();

  function createGridHero(THREE: typeof import('three'), canvas: HTMLCanvasElement, reduced: boolean) {
    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.7));
    const scene = new THREE.Scene();
    const cam = new THREE.PerspectiveCamera(40, 1, 0.1, 100);
    cam.position.set(0, 0, 15);
    const group = new THREE.Group();
    scene.add(group);
    const GREY = new THREE.Color('#CFCBC2'), BLUE = new THREE.Color('#1E5BFF');

    const SPAN_X = 30, SPAN_Y = 17, COLS = 30, ROWS = 15;
    const verticals: any[] = [], horizontals: any[] = [];
    for (let i = 0; i < COLS; i++) {
      const m = new THREE.Mesh(new THREE.BoxGeometry(0.05, SPAN_Y, 0.05),
        new THREE.MeshBasicMaterial({ color: GREY.clone(), transparent: true, opacity: 0.85 }));
      m.position.x = (i / (COLS - 1) - 0.5) * SPAN_X;
      m.position.z = -2 - (i % 4) * 0.65;
      group.add(m); verticals.push(m);
    }
    for (let j = 0; j < ROWS; j++) {
      const m = new THREE.Mesh(new THREE.BoxGeometry(SPAN_X + 2, 0.045, 0.045),
        new THREE.MeshBasicMaterial({ color: GREY.clone(), transparent: true, opacity: 0.5 }));
      m.position.y = (j / (ROWS - 1) - 0.5) * SPAN_Y;
      m.position.z = -3 - (j % 3) * 0.55;
      group.add(m); horizontals.push(m);
    }

    const ray = new THREE.Raycaster();
    const plane = new THREE.Plane(new THREE.Vector3(0, 0, 1), 2.5);
    const hit = new THREE.Vector3(), cursor = new THREE.Vector3(999, 999, 0);
    const ndc = new THREE.Vector2(-2, -2);
    const mouse = { x: 0, y: 0, tx: 0, ty: 0 };
    let activeT = 0, active = 0;
    const host = canvas.parentElement!;

    host.addEventListener('pointermove', (e) => {
      const r = canvas.getBoundingClientRect();
      ndc.x = ((e.clientX - r.left) / r.width) * 2 - 1;
      ndc.y = -((e.clientY - r.top) / r.height) * 2 + 1;
      mouse.tx = ndc.x; mouse.ty = ndc.y; activeT = 1;
    });
    host.addEventListener('pointerleave', () => { activeT = 0; });

    function resize() {
      const w = canvas.clientWidth, h = canvas.clientHeight;
      renderer.setSize(w, h, false); cam.aspect = w / h; cam.updateProjectionMatrix();
    }
    window.addEventListener('resize', resize); resize();

    const fall = (d: number, w: number) => Math.max(0, 1 - d / w);
    let t = 0, rafId: number | null = null;

    function renderFrame() {
      ray.setFromCamera(ndc, cam);
      if (ray.ray.intersectPlane(plane, hit)) cursor.copy(hit);
      active += (activeT - active) * 0.06;
      const scanX = Math.sin(t * 0.28) * SPAN_X * 0.52;
      const scanY = Math.cos(t * 0.2) * SPAN_Y * 0.52;
      for (const m of verticals) {
        const sc = fall(Math.abs(m.position.x - scanX), 2.6) * 0.55;
        const cu = active * fall(Math.abs(m.position.x - cursor.x), 2.1);
        const e = Math.min(1, Math.max(sc, cu));
        m.material.color.copy(GREY).lerp(BLUE, e);
        m.scale.x = 1 + e * 2.2; m.material.opacity = 0.85 + e * 0.15;
      }
      for (const m of horizontals) {
        const sc = fall(Math.abs(m.position.y - scanY), 1.9) * 0.5;
        const cu = active * fall(Math.abs(m.position.y - cursor.y), 1.8);
        const e = Math.min(1, Math.max(sc, cu));
        m.material.color.copy(GREY).lerp(BLUE, e);
        m.scale.y = 1 + e * 2.2; m.material.opacity = 0.5 + e * 0.5;
      }
      mouse.x += (mouse.tx - mouse.x) * 0.05; mouse.y += (mouse.ty - mouse.y) * 0.05;
      group.rotation.y = mouse.x * 0.34; group.rotation.x = -mouse.y * 0.2;
      renderer.render(scene, cam);
    }
    function loop() { t += 0.016; renderFrame(); rafId = requestAnimationFrame(loop); }

    return {
      start() {
        if (reduced) { renderFrame(); return; }   // one static frame, no loop
        if (rafId == null) rafId = requestAnimationFrame(loop);
      },
      stop() { if (rafId != null) { cancelAnimationFrame(rafId); rafId = null; } },
    };
  }

  /* ============ DARK SECTION: faint road-grid + electric pulses (canvas 2D) ============ */
  (function lazyNight() {
    const c = document.getElementById('nightgrid') as HTMLCanvasElement | null;
    if (!c) return;
    const ctx = c.getContext('2d');
    if (!ctx) return;
    let w = 0, h = 0;
    const dpr = Math.min(window.devicePixelRatio, 1.6);
    const trails: any[] = [];
    for (let i = 0; i < 7; i++) trails.push({ y: Math.random(), x: Math.random(), sp: 0.0008 + Math.random() * 0.0016, len: 0.08 + Math.random() * 0.12 });
    function size() { w = c!.width = c!.clientWidth * dpr; h = c!.height = c!.clientHeight * dpr; }
    window.addEventListener('resize', size); size();

    let rafId: number | null = null;
    function drawFrame() {
      ctx!.clearRect(0, 0, w, h);
      ctx!.strokeStyle = 'rgba(255,255,255,0.05)'; ctx!.lineWidth = 1;
      const sx = w / 14; for (let x = 0; x <= w; x += sx) { ctx!.beginPath(); ctx!.moveTo(x, 0); ctx!.lineTo(x, h); ctx!.stroke(); }
      const sy = h / 8; for (let y = 0; y <= h; y += sy) { ctx!.beginPath(); ctx!.moveTo(0, y); ctx!.lineTo(w, y); ctx!.stroke(); }
      for (const tr of trails) {
        tr.x += tr.sp; if (tr.x > 1.2) tr.x = -0.2;
        const px = tr.x * w, py = tr.y * h, g = ctx!.createLinearGradient(px - tr.len * w, py, px, py);
        g.addColorStop(0, 'rgba(30,91,255,0)'); g.addColorStop(1, 'rgba(110,150,255,0.9)');
        ctx!.strokeStyle = g; ctx!.lineWidth = 2; ctx!.beginPath(); ctx!.moveTo(px - tr.len * w, py); ctx!.lineTo(px, py); ctx!.stroke();
      }
    }
    function loop() { drawFrame(); rafId = requestAnimationFrame(loop); }
    const api = {
      start() { if (reduced) { drawFrame(); return; } if (rafId == null) rafId = requestAnimationFrame(loop); },
      stop() { if (rafId != null) { cancelAnimationFrame(rafId); rafId = null; } },
    };
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) { if (e.isIntersecting) api.start(); else api.stop(); }
    }, { threshold: 0.01 });
    io.observe(c);
  })();

  /* ============ GSAP scroll motion (skipped entirely when reduced) ============ */
  if (!reduced) {
    gsap.registerPlugin(ScrollTrigger);
    gsap.fromTo('.hero .reveal', { y: 26, opacity: 0 }, { y: 0, opacity: 1, duration: 0.9, stagger: 0.12, ease: 'power3.out', delay: 0.2 });
    gsap.utils.toArray<HTMLElement>('.stance .reveal, .cta .reveal').forEach((el) => {
      gsap.fromTo(el, { y: 34, opacity: 0 }, { y: 0, opacity: 1, duration: 0.8, ease: 'power3.out', scrollTrigger: { trigger: el, start: 'top 85%' } });
    });
    gsap.fromTo('.card', { y: 40, opacity: 0 }, { y: 0, opacity: 1, duration: 0.7, stagger: 0.12, ease: 'power3.out', scrollTrigger: { trigger: '.feat-grid', start: 'top 82%' } });
    gsap.fromTo('.hub', { y: 40, opacity: 0 }, { y: 0, opacity: 1, duration: 0.7, stagger: 0.1, ease: 'power3.out', scrollTrigger: { trigger: '.hub-grid', start: 'top 82%' } });
    gsap.utils.toArray<HTMLElement>('.math .stat').forEach((stat, i) => {
      ScrollTrigger.create({
        trigger: '.math', start: 'top 65%', once: true,
        onEnter: () => {
          const fig = stat.querySelector('.fig') as HTMLElement;
          const target = parseFloat(fig.dataset.count || '0');
          const dec = parseInt(fig.dataset.dec || '0');
          const pre = fig.dataset.prefix || '';
          const unitEl = (fig.querySelector('.unit') as HTMLElement).outerHTML;
          const obj = { v: 0 };
          gsap.to(obj, { v: target, duration: 1.3, delay: i * 0.12, ease: 'power2.out', onUpdate: () => { fig.innerHTML = pre + obj.v.toFixed(dec) + unitEl; } });
          const bar = stat.querySelector('.bar') as HTMLElement;
          gsap.to(bar, { width: bar.dataset.bar + '%', duration: 1.3, delay: i * 0.12, ease: 'power2.out' });
        },
      });
    });
  }
</script>
