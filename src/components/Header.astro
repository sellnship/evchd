---
import Brand from './Brand.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n';
import { resolveCounterpart } from '../lib/counterpart';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links = [
  { key: 'nav.guides', href: '/guides' },
  { key: 'nav.compare', href: '/compare' },
  { key: 'nav.calculators', href: '/calculators' },
  { key: 'nav.about', href: '/about' },
].map((l) => ({ label: t(l.key as any), href: localizePath(l.href, lang) }));

// Language toggle → the counterpart page. Uses the SAME resolver the <head>
// hreflang uses, so the human link and the machine signal never disagree. For
// article detail pages with no translation yet it falls back to the counterpart
// section listing (which always exists) — never a dead link.
const { href: toggleHref } = await resolveCounterpart(Astro.url.pathname, lang);
const toggleLabel = t('toggle.label');
const toggleAria = t('toggle.aria');
const homeHref = localizePath('/', lang);
---
<header class="nav">
  <div class="wrap nav-inner">
    <Brand href={homeHref} />
    <div class="nav-right">
      <nav class="nav-links" aria-label={t('nav.primary')}>
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
      <!-- Language pill lives in the top bar so it's ALWAYS visible (never hidden
           inside the hamburger). Routes to the exact EN↔HI counterpart. -->
      <a class="lang-toggle" href={toggleHref} aria-label={toggleAria} hreflang={lang === 'hi' ? 'en' : 'hi'}>{toggleLabel}</a>
      <button
        type="button"
        class="nav-toggle"
        aria-label={t('menu.open')}
        data-label-open={t('menu.open')}
        data-label-close={t('menu.close')}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="nav-toggle-bars" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
    </div>
  </div>

  <!-- Mobile drawer (≤900px). Starts inert so its links aren't focusable/announced
       while closed; JS toggles inert + data-open. prefers-reduced-motion handled in CSS. -->
  <div id="mobile-menu" class="mobile-menu" data-open="false" inert>
    <div class="mobile-menu-panel" role="dialog" aria-modal="true" aria-label={t('menu.dialog')}>
      <nav class="mobile-menu-links" aria-label={t('nav.primary')}>
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    const panel = menu.querySelector<HTMLElement>('.mobile-menu-panel');
    const labelOpen = toggle.dataset.labelOpen || 'Open menu';
    const labelClose = toggle.dataset.labelClose || 'Close menu';

    const open = () => {
      menu.dataset.open = 'true';
      menu.removeAttribute('inert');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', labelClose); // icon flips to an X — announce "close"
      document.body.style.overflow = 'hidden';
      menu.querySelector<HTMLAnchorElement>('a')?.focus();
    };

    const close = ({ refocus = true } = {}) => {
      menu.dataset.open = 'false';
      menu.setAttribute('inert', '');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', labelOpen);
      document.body.style.overflow = '';
      if (refocus) toggle.focus();
    };

    const isOpen = () => menu.dataset.open === 'true';

    toggle.addEventListener('click', () => (isOpen() ? close() : open()));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => close({ refocus: false })));
    menu.addEventListener('click', (e) => {
      if (panel && !panel.contains(e.target as Node)) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) close();
    });
    const mq = window.matchMedia('(min-width: 901px)');
    mq.addEventListener('change', (e) => {
      if (e.matches && isOpen()) close({ refocus: false });
    });
  }

  /* Headroom: pinned at top; hide on scroll-down past ~80px, reveal on scroll-up.
     rAF-throttled for budget Android. Reduced-motion → stay pinned (no hiding). */
  const header = document.querySelector<HTMLElement>('header.nav');
  if (header) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const TOP = 8;        // show the hairline/shadow once scrolled past this
    const HIDE_AFTER = 80; // never hide within this distance of the top
    let lastY = window.scrollY;
    let ticking = false;

    const update = () => {
      const y = window.scrollY;
      header.classList.toggle('nav--scrolled', y > TOP);
      if (!reduced) {
        if (y <= HIDE_AFTER) {
          header.classList.remove('nav--hidden'); // always shown near the top
        } else if (y > lastY + 2 && menu?.dataset.open !== 'true') {
          header.classList.add('nav--hidden'); // scrolling down (not while drawer open)
        } else if (y < lastY - 2) {
          header.classList.remove('nav--hidden'); // scrolling up → reveal immediately
        }
      }
      lastY = y;
      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>
