---
import Brand from './Brand.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations, localizePath, counterpartPath, toEnPath } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links = [
  { key: 'nav.guides', href: '/guides' },
  { key: 'nav.compare', href: '/compare' },
  { key: 'nav.calculators', href: '/calculators' },
  { key: 'nav.news', href: '/news' },
  { key: 'nav.about', href: '/about' },
].map((l) => ({ label: t(l.key as any), href: localizePath(l.href, lang) }));

// Language toggle → the counterpart page. For article detail pages the
// translation may not exist yet, so verify it and otherwise fall back to the
// counterpart section listing (which always exists) — never a dead link.
const CONTENT_SECTIONS = ['guides', 'compare', 'news', 'glossary'];
let toggleHref = counterpartPath(Astro.url.pathname, lang);
const segs = toEnPath(Astro.url.pathname).split('/').filter(Boolean);
if (segs.length === 2 && CONTENT_SECTIONS.includes(segs[0])) {
  const [section, slug] = segs;
  const otherLang = lang === 'hi' ? 'en' : 'hi';
  const wantId = otherLang === 'hi' ? `hi/${slug}` : slug;
  const entries = await getCollection(section as any, ({ data }: any) => data.lang === otherLang);
  const exists = entries.some((e: any) => e.id === wantId);
  if (!exists) toggleHref = localizePath(`/${section}`, otherLang);
}
const toggleLabel = t('toggle.label');
const toggleAria = t('toggle.aria');
const homeHref = localizePath('/', lang);
---
<header class="nav">
  <div class="wrap nav-inner">
    <Brand href={homeHref} />
    <div class="nav-right">
      <nav class="nav-links" aria-label={t('nav.primary')}>
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
      <!-- Language pill lives in the top bar so it's ALWAYS visible (never hidden
           inside the hamburger). Routes to the exact EN↔HI counterpart. -->
      <a class="lang-toggle" href={toggleHref} aria-label={toggleAria} hreflang={lang === 'hi' ? 'en' : 'hi'}>{toggleLabel}</a>
      <button
        type="button"
        class="nav-toggle"
        aria-label={t('menu.open')}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="nav-toggle-bars" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
    </div>
  </div>

  <!-- Mobile drawer (≤900px). Starts inert so its links aren't focusable/announced
       while closed; JS toggles inert + data-open. prefers-reduced-motion handled in CSS. -->
  <div id="mobile-menu" class="mobile-menu" data-open="false" inert>
    <div class="mobile-menu-panel" role="dialog" aria-modal="true" aria-label="Site menu">
      <nav class="mobile-menu-links" aria-label={t('nav.primary')}>
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    const panel = menu.querySelector<HTMLElement>('.mobile-menu-panel');
    const openLabel = toggle.getAttribute('aria-label') || 'Open menu';

    const open = () => {
      menu.dataset.open = 'true';
      menu.removeAttribute('inert');
      toggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      menu.querySelector<HTMLAnchorElement>('a')?.focus();
    };

    const close = ({ refocus = true } = {}) => {
      menu.dataset.open = 'false';
      menu.setAttribute('inert', '');
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      if (refocus) toggle.focus();
    };

    const isOpen = () => menu.dataset.open === 'true';

    toggle.addEventListener('click', () => (isOpen() ? close() : open()));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => close({ refocus: false })));
    menu.addEventListener('click', (e) => {
      if (panel && !panel.contains(e.target as Node)) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) close();
    });
    const mq = window.matchMedia('(min-width: 901px)');
    mq.addEventListener('change', (e) => {
      if (e.matches && isOpen()) close({ refocus: false });
    });
    // keep aria-label honest for screen readers as the icon flips to an X
    void openLabel;
  }
</script>
