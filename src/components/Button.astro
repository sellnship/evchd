---
/**
 * Button — the reference's button variants:
 *   solid (.btn) · ghost (.btn-ghost) · light (.btn.btn-light) · wa (.btn.btn-wa)
 * Label goes in the slot. `arrow` appends the animated → (for solid-style
 * variants). Extra attributes (href, target, rel, data-cta, aria-*) pass
 * straight through to the <a>.
 */
import type { HTMLAttributes } from 'astro/types';
interface Props extends HTMLAttributes<'a'> {
  variant?: 'solid' | 'ghost' | 'light' | 'wa';
  arrow?: boolean;
}
const { variant = 'solid', href = '#', arrow = false, class: className, ...rest } = Astro.props;
const base = { solid: 'btn', ghost: 'btn-ghost', light: 'btn btn-light', wa: 'btn btn-wa' }[variant];
---
<a class:list={[base, className]} href={href} {...rest}>
  <slot />{arrow && <span class="arr disp">→</span>}
</a>
