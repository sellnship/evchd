---
/**
 * ChargeBar — the site's signature motif.
 *
 * A segmented EV charge indicator. It reads as battery/energy (true to the
 * subject) and its modular segments echo Chandigarh's béton-brut formwork and
 * brise-soleil louvers. Reused as the brand mark, the section marker, and the
 * hero gauge. Purely decorative, so it is hidden from assistive tech — meaning
 * is always carried by adjacent text.
 */
interface Props {
  segments?: number;
  filled?: number;
  block?: boolean;
  animate?: boolean;
  class?: string;
}
const {
  segments = 5,
  filled = 3,
  block = false,
  animate = false,
  class: className = '',
} = Astro.props;
const segs = Array.from({ length: segments }, (_, i) => i < filled);
---
<span
  class:list={['charge-bar', { 'is-block': block }, className]}
  data-animate={animate ? '' : undefined}
  aria-hidden="true"
>
  {segs.map((on, i) => (
    <span class:list={['seg', { 'is-on': on }]} style={`--i:${i}`}></span>
  ))}
</span>
