---
/**
 * ModelCompare — a genuinely brand-neutral, spec-CLASS comparison for the
 * low-speed (licence-free) category. Columns are CLASSES (entry commuter,
 * everyday step-through, long-range / work); each lists >=3 representative
 * models across brands and a typical price BAND — never a per-SKU price.
 * Pass `classes` to pick/order specific class ids; omit it to show all.
 * On narrow screens the table scrolls horizontally with the spec column
 * pinned, so it never breaks on a phone.
 */
import { models as modelsData, type SpecClass } from '../data/types';

interface Props { classes?: string[]; }
const { classes: ids } = Astro.props;

const all = modelsData.classes;
const picked: SpecClass[] =
  ids && ids.length ? (ids.map((id) => all.find((c) => c.id === id)).filter((c): c is SpecClass => Boolean(c))) : all;
const cols = picked.length ? picked : all;

const reps = (c: SpecClass) => c.representative_models.map((r) => `${r.brand} ${r.model}`).join(', ');
const band = (s: string) => `₹${s.replace('-', '–')}`;

const rows: { label: string; get: (c: SpecClass) => string }[] = [
  { label: 'Who it suits', get: (c) => c.who },
  { label: 'Real range', get: (c) => `${c.spec.range_km.replace('-', '–')} km` },
  { label: 'Battery', get: (c) => c.spec.battery },
  { label: 'Body', get: (c) => c.spec.body },
  { label: 'Typical price band', get: (c) => band(c.spec.price_band_inr) },
  { label: 'Examples (across brands)', get: reps },
  { label: 'Trade-off', get: (c) => c.tradeoff },
];
---
<figure class="modelcompare" role="group" aria-label="Low-speed electric scooter comparison by spec class">
  <div class="mc-scroll">
    <table class="mc-table">
      <thead>
        <tr>
          <th scope="col" class="mc-attr">Spec class</th>
          {cols.map((c) => <th scope="col" class="disp">{c.label}</th>)}
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <th scope="row" class="mc-attr mono">{r.label}</th>
            {cols.map((c) => <td>{r.get(c)}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <figcaption class="mc-note mono">
    Whole class is ≤25 km/h, ≤250W — no licence, no RTO, no road tax. Compare by class and spec, not by brand; the models named are examples, not recommendations. Price bands are indicative and variant-dependent — confirm locally before buying.
  </figcaption>
</figure>

<style>
  .modelcompare { margin: clamp(32px, 5vw, 48px) 0; }
  .mc-scroll { overflow-x: auto; border: 1px solid var(--grid); -webkit-overflow-scrolling: touch; }
  .mc-table { width: 100%; border-collapse: collapse; min-width: 520px; font-family: 'Source Serif 4', Georgia, serif; }
  .mc-table th, .mc-table td { padding: 12px 16px; text-align: left; border-bottom: 1px solid var(--grid); font-size: 0.95rem; vertical-align: top; }
  .mc-table thead th { background: var(--concrete-2); font-weight: 700; font-size: 1rem; letter-spacing: -0.01em; white-space: nowrap; }
  .mc-table tbody tr:last-child th, .mc-table tbody tr:last-child td { border-bottom: none; }
  .mc-attr { position: sticky; left: 0; z-index: 1; background: var(--concrete); border-right: 1px solid var(--grid); font-weight: 400; color: var(--ink-soft); white-space: nowrap; }
  .mc-table thead .mc-attr { background: var(--concrete-2); color: var(--ink); }
  .mc-table tbody td { color: var(--ink); }
  .mc-note { margin-top: 12px; font-size: 11px; letter-spacing: 0.04em; color: var(--ink-soft); line-height: 1.5; }
</style>
