---
import Brand from './Brand.astro';
import Divider from './Divider.astro';

const sections = [
  { label: 'Guides', href: '/guides' },
  { label: 'Comparisons', href: '/compare' },
  { label: 'Calculators', href: '/calculators' },
  { label: 'News', href: '/news' },
];
const publication = [
  { label: 'About', href: '/about' },
  { label: 'Editorial policy', href: '/editorial-policy' },
  { label: 'RSS / Follow', href: '/rss.xml' },
  { label: 'Contact', href: '/contact' },
];
const year = new Date().getFullYear();
---
<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <Brand href="/" />
        <p>Independent, local electric-mobility guidance for Chandigarh, Mohali and Panchkula.</p>
      </div>
      <nav class="foot-cols" aria-label="Footer">
        <div>{sections.map((l) => <a href={l.href}>{l.label}</a>)}</div>
        <div>{publication.map((l) => <a href={l.href}>{l.label}</a>)}</div>
      </nav>
    </div>
    <Divider style="margin-top:40px;" />
    <div class="foot-bottom">© {year} EV Chandigarh · An independent publication · We don't sell vehicles</div>
  </div>
</footer>
